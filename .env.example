# Salin file ini menjadi .env lalu sesuaikan nilainya.
PORT=3000

# PostgreSQL dari Docker (port host 5433)
# Format: postgresql://USER:PASSWORD@HOST:PORT/NAMA_DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/db_student?schema=public"

# Kalau memakai PostgreSQL lokal di port 5432, ubah bagian port dan password.
# DATABASE_URL="postgresql://postgres:password@127.0.0.1:5432/db_student?schema=public"
