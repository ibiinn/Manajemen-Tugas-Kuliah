{
  "name": "student-api",
  "version": "2.0.0",
  "private": true,
  "description": "Tugas 10: REST API data student dengan Express + PostgreSQL + Prisma ORM",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "node --watch src/app.js",
    "db:migrate": "prisma migrate dev",
