{
  "info": {
    "_postman_id": "b7f1c2c4-5d10-4a9e-9d02-tugas10prisma",
    "name": "Student API - Tugas 10 (PostgreSQL + Prisma)",
    "description": "Collection pengujian REST API Student: CRUD dengan Prisma Client, filter where, dan statistik count/groupBy.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Health Check",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code 200', () => pm.response.to.have.status(200));",
              "pm.test('Server mengembalikan daftar endpoint', () => {",
              "  pm.expect(pm.response.json().endpoints).to.be.an('array');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/",
          "host": ["{{baseUrl}}"],
          "path": [""]
        }
      }
    },
    {
      "name": "2. Get Semua Student",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code 200', () => pm.response.to.have.status(200));",
              "pm.test('Response sukses dan berisi data student', () => {",
              "  const json = pm.response.json();",
              "  pm.expect(json.success).to.eql(true);",
              "  pm.expect(json.data).to.be.an('array');",
              "  pm.expect(json.total).to.be.at.least(5);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/students",
          "host": ["{{baseUrl}}"],
          "path": ["api", "students"]
        }
      }
    },
    {
      "name": "3. Filter by Jurusan (where)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code 200', () => pm.response.to.have.status(200));",
              "pm.test('Semua data sesuai filter jurusan', () => {",
              "  const json = pm.response.json();",
              "  pm.expect(json.data.length).to.be.above(0);",
              "  json.data.forEach((student) => {",
              "    pm.expect(student.jurusan.toLowerCase()).to.include('informatika');",
              "  });",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/students?jurusan=informatika",
          "host": ["{{baseUrl}}"],
          "path": ["api", "students"],
          "query": [{ "key": "jurusan", "value": "informatika" }]
        }
      }
    },
    {
      "name": "4. Filter Angkatan + Search",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code 200', () => pm.response.to.have.status(200));",
              "pm.test('Filter angkatan dan search bekerja', () => {",
              "  const json = pm.response.json();",
              "  pm.expect(json.data.length).to.be.above(0);",
              "  json.data.forEach((student) => {",
              "    pm.expect(student.angkatan).to.eql(2022);",
              "    pm.expect(student.nama.toLowerCase()).to.include('eka');",
              "  });",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/students?angkatan=2022&search=eka",
          "host": ["{{baseUrl}}"],
          "path": ["api", "students"],
          "query": [
            { "key": "angkatan", "value": "2022" },
            { "key": "search", "value": "eka" }
          ]
        }
      }
    },
    {
      "name": "5. Statistik Student (count/groupBy)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code 200', () => pm.response.to.have.status(200));",
              "pm.test('Statistik berisi total dan rekap per jurusan', () => {",
              "  const json = pm.response.json();",
              "  pm.expect(json.data.total).to.be.a('number');",
              "  pm.expect(json.data.perJurusan).to.be.an('array');",
              "  pm.expect(json.data.perAngkatan).to.be.an('array');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/students/stats",
          "host": ["{{baseUrl}}"],
          "path": ["api", "students", "stats"]
        }
      }
    },
    {
      "name": "6. Get Detail Student (id = 2)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code 200', () => pm.response.to.have.status(200));",
              "pm.test('Data student ditemukan', () => {",
              "  const json = pm.response.json();",
              "  pm.expect(json.data.id).to.eql(2);",
              "  pm.expect(json.data).to.have.property('created_at');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/students/2",
          "host": ["{{baseUrl}}"],
          "path": ["api", "students", "2"]
        }
      }
    },
    {
      "name": "7. Get Detail Student - tidak ditemukan (id = 999)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code 404', () => pm.response.to.have.status(404));",
              "pm.test('Pesan tidak ditemukan', () => {",
              "  pm.expect(pm.response.json().success).to.eql(false);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/students/999",
          "host": ["{{baseUrl}}"],
          "path": ["api", "students", "999"]
        }
      }
    },
    {
      "name": "8. Create Student",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// NIM unik 15 digit agar collection bisa dijalankan berulang",
              "const nim = '1030' + Date.now().toString().slice(-11);",
              "pm.collectionVariables.set('nimBaru', nim);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code 201', () => pm.response.to.have.status(201));",
              "pm.test('Student baru tersimpan di PostgreSQL', () => {",
              "  const json = pm.response.json();",
              "  pm.expect(json.success).to.eql(true);",
              "  pm.expect(json.data.nim).to.eql(pm.collectionVariables.get('nimBaru'));",
              "  pm.collectionVariables.set('studentId', json.data.id);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nim\": \"{{nimBaru}}\",\n  \"nama\": \"Rina Maharani\",\n  \"jurusan\": \"Sistem Informasi\",\n  \"angkatan\": 2024,\n  \"email\": \"{{nimBaru}}@student.telkomuniversity.ac.id\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/api/students",
          "host": ["{{baseUrl}}"],
          "path": ["api", "students"]
        }
      }
    },
    {
      "name": "9. Create Student - NIM duplikat (409)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code 409', () => pm.response.to.have.status(409));",
              "pm.test('Pesan NIM sudah terdaftar', () => {",
              "  pm.expect(pm.response.json().message).to.include('sudah terdaftar');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nim\": \"{{nimBaru}}\",\n  \"nama\": \"Duplikat\",\n  \"jurusan\": \"Informatika\",\n  \"angkatan\": 2023,\n  \"email\": \"duplikat@student.telkomuniversity.ac.id\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/api/students",
          "host": ["{{baseUrl}}"],
          "path": ["api", "students"]
        }
      }
    },
    {
      "name": "10. Create Student - data tidak valid (400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code 400', () => pm.response.to.have.status(400));",
              "pm.test('Ada daftar error validasi', () => {",
              "  pm.expect(pm.response.json().errors).to.be.an('array');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nim\": \"103022300099\",\n  \"nama\": \"Tanpa Jurusan\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/api/students",
          "host": ["{{baseUrl}}"],
          "path": ["api", "students"]
        }
      }
    },
    {
      "name": "11. Update Student",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code 200', () => pm.response.to.have.status(200));",
              "pm.test('Data student berhasil diperbarui', () => {",
              "  const json = pm.response.json();",
              "  pm.expect(json.data.angkatan).to.eql(2024);",
              "  pm.expect(json.data.jurusan).to.eql('Informatika');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"jurusan\": \"Informatika\",\n  \"angkatan\": 2024\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/api/students/{{studentId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "students", "{{studentId}}"]
        }
      }
    },
    {
      "name": "12. Delete Student",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code 200', () => pm.response.to.have.status(200));",
              "pm.test('Student berhasil dihapus', () => {",
              "  pm.expect(pm.response.json().data.id).to.eql(pm.collectionVariables.get('studentId'));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/students/{{studentId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "students", "{{studentId}}"]
        }
      }
    },
    {
      "name": "13. Get Student Setelah Delete (404)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code 404', () => pm.response.to.have.status(404));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/students/{{studentId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "students", "{{studentId}}"]
        }
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" }
  ]
}
